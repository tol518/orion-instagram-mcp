{
  "name": "@orion-os/instagram-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Official Instagram API MCP service with deterministic policy and persistent interaction history",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "dev": "npm run build && node --env-file-if-exists=.env dist/index.js",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests && prettier --check . --ignore-unknown",
    "format": "prettier --write . --ignore-unknown",
    "test": "vitest run --maxWorkers=1",
    "operator": "node --env-file-if-exists=.env dist/operator.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/client": "2.0.0",
    "zod": "4.5.4",
    "kysely": "0.29.5",
    "pino": "10.3.1",
    "fastify": "5.12.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "6.0.3",
    "vitest": "5.0.0",
    "eslint": "10.10.0",
    "typescript-eslint": "8.69.0",
    "prettier": "3.9.6"
  }
}
